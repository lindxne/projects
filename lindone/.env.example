# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# The only e-mail that may request a magic link. Must match private.owner in the database.
OWNER_EMAIL=you@example.com

# Public origin of the app, used in magic links.
NEXT_PUBLIC_SITE_URL=https://lindone.com

# Largest audio / video file accepted by the upload forms, in MB (Supabase free plan: 50).
NEXT_PUBLIC_MAX_UPLOAD_MB=50

# Only for `npm run backup` (never expose to the browser, never set on Vercel).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
